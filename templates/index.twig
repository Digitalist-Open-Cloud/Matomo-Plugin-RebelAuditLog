{% extends 'admin.twig' %}

{% set title %}{{ 'RebelAuditLog_RebelAuditLog'|translate }}{% endset %}

{% block content %}
<div class="card rebelAuditLog">
    <div class="card-content">
        <a class="rebelAuditLog__brand" href="https://digitalist.cloud/" rel="noreferrer noopener" target="_blank">
            <img src="plugins/RebelAuditLog/assets/dot.png" height="40" alt="Digitalist Open Cloud" />
        </a>
        <h2 class="card-title">{{ 'RebelAuditLog_RebelAuditLog'|translate }}</h2>
        <p>{{ 'RebelAuditLog_Intro'|translate }}</p>

        <div
            class="borderedControl rebelAuditLog__period"
            vue-entry="CoreHome.PeriodSelector"
            periods="{{ ['day', 'week', 'month', 'year', 'range']|json_encode }}"
        ></div>

        <form class="rebelAuditLog__filters" action="index.php" method="get">
            <input type="hidden" name="module" value="RebelAuditLog" />
            <input type="hidden" name="action" value="index" />
            <input type="hidden" name="period" value="{{ query.period }}" />
            <input type="hidden" name="date" value="{{ query.date }}" />

            <label>
                {{ 'RebelAuditLog_FilterByUser'|translate }}
                <select name="user" class="browser-default">
                    <option value="">{{ 'RebelAuditLog_AllUsers'|translate }}</option>
                    {% for user in users %}
                        <option value="{{ user }}" {% if user == filters.user %}selected{% endif %}>{{ user }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                {{ 'RebelAuditLog_FilterByEvent'|translate }}
                <select name="event_base" class="browser-default">
                    <option value="">{{ 'RebelAuditLog_AllEvents'|translate }}</option>
                    {% for eventBase in eventBases %}
                        <option value="{{ eventBase }}" {% if eventBase == filters.eventBase %}selected{% endif %}>{{ eventBase }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="rebelAuditLog__checkbox">
                <input type="checkbox" name="excludeConsole" value="1" {% if filters.excludeConsole %}checked{% endif %} />
                <span>{{ 'RebelAuditLog_ExcludeConsole'|translate(consoleUser) }}</span>
            </label>
            <button type="submit" class="btn">{{ 'RebelAuditLog_Filter'|translate }}</button>
        </form>

        <p class="rebelAuditLog__export">
            <span class="icon-download"></span>
            <a href="{{ linkTo({
                'module': 'API',
                'method': 'RebelAuditLog.getAudits',
                'format': 'CSV',
                'force_api_session': 1,
                'token_auth': token_auth,
                'order': 'ASC',
                'limit': 10000000,
                'filter_limit': -1,
                'selectedUser': filters.user,
                'selectedEventBase': filters.eventBase,
                'excludeConsole': query.excludeConsole,
                'startDate': dates.startDate,
                'endDate': dates.endDate,
            }) }}">{{ 'RebelAuditLog_ExportCsv'|translate }}</a>
            ·
            <a href="{{ linkTo({'module': 'API', 'action': 'listAllAPI'}) }}#RebelAuditLog">{{ 'RebelAuditLog_MoreExportFormats'|translate }}</a>
        </p>

        <table class="entityTable dataTable rebelAuditLog__table">
            <thead>
                <tr>
                    <th>{{ 'RebelAuditLog_Timestamp'|translate }}</th>
                    <th>{{ 'RebelAuditLog_User'|translate }}</th>
                    <th>{{ 'RebelAuditLog_IP'|translate }}</th>
                    <th>{{ 'RebelAuditLog_Event'|translate }}</th>
                    <th>{{ 'RebelAuditLog_EventTask'|translate }}</th>
                    <th>{{ 'RebelAuditLog_Log'|translate }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in audits %}
                    <tr>
                        <td class="rebelAuditLog__time">{{ entry.timestamp }}</td>
                        <td>{{ entry.user }}</td>
                        <td>{{ entry.ip }}</td>
                        <td>{{ entry.event_base }}</td>
                        <td>{{ entry.event_task }}</td>
                        <td class="rebelAuditLog__message">{{ entry.audit_log }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">{{ 'RebelAuditLog_NoEntries'|translate }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="rebelAuditLog__pages">
            <span>{{ 'RebelAuditLog_Total'|translate(total) }}</span>
            {% if totalPages > 1 %}
                {% if currentPage > 1 %}
                    <a class="rebelAuditLog__previous" href="{{ linkTo(query|merge({'module': 'RebelAuditLog', 'action': 'index', 'page': currentPage - 1})) }}">
                        <span class="icon-arrow-left"></span> {{ 'General_Previous'|translate }}
                    </a>
                {% endif %}
                <span>{{ 'RebelAuditLog_PageOf'|translate(currentPage, totalPages) }}</span>
                {% if currentPage < totalPages %}
                    <a class="rebelAuditLog__next" href="{{ linkTo(query|merge({'module': 'RebelAuditLog', 'action': 'index', 'page': currentPage + 1})) }}">
                        {{ 'General_Next'|translate }} <span class="icon-arrow-right"></span>
                    </a>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
